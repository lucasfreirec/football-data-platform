DATABASE_URL=postgresql+psycopg://football:football@localhost:5432/football_data
APP_ENV=development
LOG_LEVEL=INFO
STATSBOMB_SOURCE_DIR=./data/raw
API_HOST=0.0.0.0
API_PORT=8000

# Optional: base URL used only when downloading source files instead of reading them locally.
STATSBOMB_BASE_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data

# Asynchronous processing (Celery + Redis). Development defaults only.
BROKER_URL=redis://localhost:6379/0
JOB_QUEUE_NAME=football-jobs
WORKER_CONCURRENCY=2
# The worker serves /metrics and /healthz here. 0 disables it.
WORKER_METRICS_PORT=9100
JOB_MAX_ATTEMPTS=3
# Seconds to wait before attempt 2, 3, ...; the last value repeats.
JOB_RETRY_DELAYS_SECONDS=5,30,120
STALE_JOB_MINUTES=15
